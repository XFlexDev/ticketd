DISCORD_TOKEN=your-bot-token

# KreatixDB
KDB_URL=https://db-prod-01.eu-central-1.kreatix.dev/api/databases/<db-id>
KDB_KEY=kdb_...

# LLM (OpenAI-compatible: NVIDIA NIM, StepFun, etc). Comma-separated keys rotate.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...,nvapi-...
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# optional
AI_ENABLED=1
TICKET_PREFIX=ticket
DEV_GUILD_ID=            # set for instant command registration while testing

# dashboard (optional)
DASHBOARD_ENABLED=1
DASHBOARD_PORT=8420
DASHBOARD_BASE_URL=https://tickets.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
